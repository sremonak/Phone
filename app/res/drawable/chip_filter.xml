<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="?attr/av_colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="?attr/av_colorSurface2" />
            <stroke android:width="1dp" android:color="?attr/av_colorDivider" />
        </shape>
    </item>
</selector>
