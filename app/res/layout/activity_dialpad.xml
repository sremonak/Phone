<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:tint="?attr/av_colorText"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/open_keypad"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/av_colorText" />

        <View
            android:layout_width="44dp"
            android:layout_height="44dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/dialNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:background="@null"
        android:hint="@string/dial_number_hint"
        android:textColorHint="?attr/av_colorTextSecondary"
        android:textColor="?attr/av_colorText"
        android:textSize="30sp"
        android:fontFamily="sans-serif-light"
        android:inputType="phone"
        android:maxLines="1"
        android:singleLine="true"
        android:imeOptions="actionDone"
        android:cursorVisible="true"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/dialInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="?attr/av_colorTextSecondary"
        android:textSize="13sp"
        android:visibility="gone"
        android:maxLines="2" />

    <HorizontalScrollView
        android:id="@+id/suggestionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="12dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/suggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:tag="1"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" " android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.2" />
            </LinearLayout>

            <LinearLayout
                android:tag="2"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ABC" android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.2" />
            </LinearLayout>

            <LinearLayout
                android:tag="3"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEF" android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.2" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:tag="4"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GHI" android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.2" />
            </LinearLayout>

            <LinearLayout
                android:tag="5"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JKL" android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.2" />
            </LinearLayout>

            <LinearLayout
                android:tag="6"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MNO" android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.2" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:tag="7"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PQRS" android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.15" />
            </LinearLayout>

            <LinearLayout
                android:tag="8"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TUV" android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.2" />
            </LinearLayout>

            <LinearLayout
                android:tag="9"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WXYZ" android:textSize="10sp" android:textColor="?attr/av_colorTextSecondary" android:letterSpacing="0.15" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:tag="*"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="*" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <LinearLayout
                android:tag="0"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:textSize="12sp" android:textColor="?attr/av_colorTextSecondary" />
            </LinearLayout>

            <LinearLayout
                android:tag="#"
                android:onClick="onDialKey"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_key">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#" android:textSize="28sp" android:textColor="?attr/av_colorText" android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="30dp"
        android:paddingStart="36dp"
        android:paddingEnd="36dp">

        <ImageButton
            android:id="@+id/btnAddContact"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_circle_soft"
            android:src="@drawable/ic_person_add"
            android:tint="?attr/av_colorText"
            android:scaleType="center"
            android:padding="15dp"
            android:contentDescription="@string/add_contact" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnCall"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/fab_bg"
            android:src="@drawable/ic_phone"
            android:tint="@color/white"
            android:scaleType="center"
            android:padding="18dp"
            android:elevation="6dp"
            android:contentDescription="@string/call" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_circle_soft"
            android:src="@drawable/ic_delete"
            android:tint="?attr/av_colorText"
            android:scaleType="center"
            android:padding="15dp"
            android:visibility="invisible"
            android:contentDescription="@string/delete_char" />
    </LinearLayout>
</LinearLayout>
