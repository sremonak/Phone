<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="64dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/callStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/incoming_call"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:textColor="#B3FFFFFF"
                android:fontFamily="sans-serif-medium" />

            <com.aurora.phone.view.AvatarView
                android:id="@+id/callAvatar"
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:layout_marginTop="30dp" />

            <TextView
                android:id="@+id/callName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textSize="30sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="330dp" />

            <TextView
                android:id="@+id/callNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="17sp"
                android:textColor="#CCFFFFFF"
                android:fontFamily="sans-serif-light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/chipLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_glass"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginEnd="7dp"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="150dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipCarrier"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_glass"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginEnd="7dp"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="150dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chipRisk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_glass"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/callTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="15sp"
                android:textColor="#99FFFFFF"
                android:fontFamily="sans-serif-light"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="44dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp">

            <LinearLayout
                android:id="@+id/controlsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="30dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnMute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/bg_call_action">

                        <ImageView
                            android:id="@+id/muteIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_mic"
                            android:tint="@color/white"
                            android:contentDescription="@string/mute" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/mute"
                        android:textSize="12sp"
                        android:textColor="#CCFFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSpeaker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/bg_call_action">

                        <ImageView
                            android:id="@+id/speakerIcon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_speaker"
                            android:tint="@color/white"
                            android:contentDescription="@string/speaker" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/speaker"
                        android:textSize="12sp"
                        android:textColor="#CCFFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnKeypadMini"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/bg_call_action">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_keypad"
                            android:tint="@color/white"
                            android:contentDescription="@string/keypad" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/keypad"
                        android:textSize="12sp"
                        android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/incomingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:id="@+id/btnDecline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/btn_decline">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:rotation="135"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/white"
                            android:contentDescription="@string/decline" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/decline"
                        android:textSize="13sp"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnQuickMsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_call_action">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_message"
                            android:tint="@color/white"
                            android:contentDescription="@string/message" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/message"
                        android:textSize="13sp"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnAnswer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/btn_answer">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/white"
                            android:contentDescription="@string/answer" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/answer"
                        android:textSize="13sp"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activeCallRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnEndCall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/btn_decline">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:rotation="135"
                            android:src="@drawable/ic_phone"
                            android:tint="@color/white"
                            android:contentDescription="@string/end_call" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/end_call"
                        android:textSize="13sp"
                        android:textColor="#E6FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/previewRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/btnCallNow"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/btn_answer">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_phone"
                        android:tint="@color/white"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/call"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/previewNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/call_permission_needed"
                    android:textSize="12sp"
                    android:textColor="#99FFFFFF"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
